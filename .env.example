# Ключи для scripts/japan.ts и scripts/supabase-admin.ts (инструменты Claude). Проект Supabase — общий с «Планером».
# Настоящие значения — только в файле .env (он в .gitignore), сюда не вписывать.
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
# Почта владельца (если в проекте Supabase больше одного пользователя)
OWNER_EMAIL=
